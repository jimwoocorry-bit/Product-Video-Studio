{
  "name": "product-video-studio",
  "version": "0.3.0-p1-final",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --use-system-ca dist/src/web/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node scripts/run-isolated-tests.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "license:gate": "node scripts/license-gate.mjs",
    "license:archive": "node scripts/archive-licenses.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "image-size": "2.0.4",
    "playwright-core": "1.63.0",
    "qrcode-svg": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "prisma": "6.12.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
